<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/ic_songq_widget_logo"
        android:contentDescription="@string/app_name" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_track_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Song/Q Studio Deck"
            android:textColor="#212121"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_track_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="MFA/PCM-Z • DirexSoft v1.15"
            android:textColor="#616161"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="#F1F1F1"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#212121"
        android:contentDescription="Poprzedni" />

    <ImageButton
        android:id="@+id/widget_btn_play"
        android:layout_width="44dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="#DD4B39"
        android:src="@android:drawable/ic_media_play"
        android:tint="#FFFFFF"
        android:contentDescription="Odtwarzaj lub pauzuj" />

    <ImageButton
        android:id="@+id/widget_btn_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:background="#F1F1F1"
        android:src="@android:drawable/ic_media_next"
        android:tint="#212121"
        android:contentDescription="Następny" />

</LinearLayout>
